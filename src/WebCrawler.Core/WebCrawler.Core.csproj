<!--
  WebCrawler.Core
  All logic (settings, models, database, queue, work). No web endpoints here, so
  the API and the separate Worker share exactly the same code.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- hosting, logging, IHttpClientFactory and BackgroundService in one reference -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

</Project>
